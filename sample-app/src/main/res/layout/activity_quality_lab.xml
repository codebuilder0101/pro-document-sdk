<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:id="@+id/labHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnLabBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Quality Diagnostics Lab"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivLabPreview"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_margin="16dp"
        android:background="@color/surface_card"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labHeader" />

    <!-- Metrics Card Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnLabPick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivLabPreview">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Overall Status Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLabStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#2200E676"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/accent"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvLabOverallStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="QUALITY GATE: PASS"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Blur / Focus Score -->
            <TextView
                android:id="@+id/tvBlurLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Focus Blur Score (Laplacian Var): 165.4 (Min: 95.0)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBlur"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:max="300"
                android:progress="165"
                app:indicatorColor="@color/primary"
                app:trackColor="#33FFFFFF" />

            <!-- Glare Ratio -->
            <TextView
                android:id="@+id/tvGlareLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Glare Hotspot Area: 0.8% (Max: 3.5%)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressGlare"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="8"
                app:indicatorColor="@color/accent"
                app:trackColor="#33FFFFFF" />

            <!-- Mean Luminance -->
            <TextView
                android:id="@+id/tvLumLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Mean Lighting Luminance: 142 (Target: 65 - 245)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressLum"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:max="255"
                android:progress="142"
                app:indicatorColor="@color/primary"
                app:trackColor="#33FFFFFF" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLabPick"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/primary"
        android:text="Test Custom Image / PDF"
        android:textColor="@android:color/white"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
